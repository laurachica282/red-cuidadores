# Copia este archivo como .env.local (Vite lo lee y .gitignore ya ignora *.local).
# Client ID de OAuth de cada proveedor (el mismo valor que GOOGLE_CLIENT_ID / MICROSOFT_CLIENT_ID del backend).
# Si queda vacío, el botón del proveedor aparece deshabilitado.
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
