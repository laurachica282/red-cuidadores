PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=red_cuidadores
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET=

# Correo (códigos y avisos del módulo cuenta). Sin SMTP_HOST, en desarrollo los correos
# se imprimen en la consola del backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Red de Cuidadores <no-responder@tu-dominio.com>

# Carpeta de fotos de perfil (opcional; por defecto backend/uploads/fotos)
UPLOADS_DIR=
